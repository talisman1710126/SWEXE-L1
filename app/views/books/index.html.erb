<h1>所有本リスト</h1>
<%= link_to "新しく登録する", new_book_path %>

<table border="1">
  <tr>
    <th>書名</th><th>著者</th><th>出版年</th><th></th>
  </tr>
  <% @books.each do |book| %>
    <tr>
      <td><%= book.title %></td>
      <td><%= book.author %></td>
      <td><%= book.published_year %></td>
      <td><%= link_to "詳細", book_path(book) %></td>
    </tr>
  <% end %>
</table>