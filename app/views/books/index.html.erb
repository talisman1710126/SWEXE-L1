<h1>所有本リスト</h1>
<p><%= link_to "新しく登録する", new_book_path, class: "button primary" %></p>

<table>
  <thead>
    <tr>
      <th>書名</th>
      <th>著者</th>
      <th>出版年</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= book.published_year %></td>
        <td class="actions">
          <%= link_to "詳細", book_path(book) %>
          <%= link_to "編集", edit_book_path(book) %>
          <%= link_to "削除", book_path(book), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>